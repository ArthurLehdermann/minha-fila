APP_NAME=MinhaFila
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://minha-fila.meugarcom.app
FRONTEND_URL=https://minha-fila.meugarcom.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=minhafila
DB_USERNAME=minhafila
DB_PASSWORD=minhafila

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# E-mail (SMTP) - Necessário para Magic Link em produção
MAIL_MAILER=smtp
MAIL_HOST=mail.meugarcom.app
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@meugarcom.app"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL=

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Magic Link
MAGIC_LINK_EXPIRE_MINUTES=15

# Broadcast / WebSockets
BROADCAST_CONNECTION=pusher
QUEUE_CONNECTION=redis

# Pusher / Soketi
PUSHER_APP_ID=2086410
PUSHER_APP_KEY=c31d1eb67de93c50e8ea
PUSHER_APP_SECRET=f7c319d8d0457ad709d2
PUSHER_HOST=minha-fila.meugarcom.app
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Frontend Environment Variables (for build-time injection)
NEXT_PUBLIC_API_URL=https://minha-fila.meugarcom.app
NEXT_PUBLIC_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
NEXT_PUBLIC_PUSHER_HOST="${PUSHER_HOST}"
NEXT_PUBLIC_PUSHER_PORT="${PUSHER_PORT}"
NEXT_PUBLIC_PUSHER_SCHEME="${PUSHER_SCHEME}"
NEXT_PUBLIC_PUSHER_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stripe / Laravel Cashier
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR
