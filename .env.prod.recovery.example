APP_NAME="Minha Fila"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://minha-fila.meugarcom.app
FRONTEND_URL=https://minha-fila.meugarcom.app
SANCTUM_STATEFUL_DOMAINS=minha-fila.meugarcom.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=minhafila
DB_USERNAME=minhafila
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.meugarcom.app

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.meugarcom.app
MAIL_PORT=465
MAIL_USERNAME=minhafila@meugarcom.app
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="minhafila@meugarcom.app"
MAIL_FROM_NAME="Minha Fila"

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic Link
MAGIC_LINK_EXPIRE_MINUTES=15

# Pusher / Soketi
PUSHER_APP_ID=minha-fila
PUSHER_APP_KEY=minha-fila-key
PUSHER_APP_SECRET=CHANGE_ME
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
