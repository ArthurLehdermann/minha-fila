APP_NAME="Minha Fila (Stage)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://stage.minhafila.vps.meugarcom.app
FRONTEND_URL=https://app-stage.minhafila.vps.meugarcom.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=minhafila_stage
DB_USERNAME=minhafila
DB_PASSWORD=minhafila

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.minhafila.vps.meugarcom.app

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@minhafila.vps.meugarcom.app"
MAIL_FROM_NAME="Minha Fila Stage"

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic Link
MAGIC_LINK_EXPIRE_MINUTES=15

# Pusher / Soketi
PUSHER_APP_ID=minha-fila-stage
PUSHER_APP_KEY=minha-fila-stage-key
PUSHER_APP_SECRET=minha-fila-stage-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
