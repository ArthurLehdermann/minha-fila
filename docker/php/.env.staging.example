APP_NAME="Minha Fila"
APP_ENV=staging
APP_KEY=CHANGE_ME
APP_DEBUG=true
APP_URL=https://minhafila-stage.vps.meugarcom.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=minhafila
DB_USERNAME=minhafila
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/

SESSION_DOMAIN=.minhafila.vps.meugarcom.app
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_ENCRYPTION=ssl
MAIL_HOST=mail.meugarcom.app
MAIL_PORT=465
MAIL_USERNAME=minhafila@meugarcom.app
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="minhafila@meugarcom.app"
MAIL_FROM_NAME="[STAGE] ${APP_NAME}"

# Storage
FILESYSTEM_DISK=s3

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=bigworks-minhafila
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_VISIBILITY=public

TELESCOPE_ENABLED=false
ADMIN_EMAIL=CHANGE_ME

SENTRY_LARAVEL_DSN=CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=CHANGE_ME
PUSHER_APP_KEY=CHANGE_ME
PUSHER_APP_SECRET=CHANGE_ME
PUSHER_APP_CLUSTER=us2
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
